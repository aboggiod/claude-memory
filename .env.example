# OpenAI MCP Connector Configuration
# Copy this file to .env and update with your values

# OAuth Configuration
OAUTH_ISSUER=https://your-domain.ngrok.io
OAUTH_AUDIENCE=gpt-memory-api

# Service Configuration
SERVICE_NAME=gpt-memory

# Database Configuration
DB_PATH=memory.db

# RSA Key Path (will be auto-generated if not exists)
RSA_KEY_PATH=rsa-private.pem
